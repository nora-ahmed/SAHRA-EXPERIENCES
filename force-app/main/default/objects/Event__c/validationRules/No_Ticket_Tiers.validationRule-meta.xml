<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Ticket_Tiers</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;On Sale&quot;),
  Total_Ticket_Tier_Capacity__c = 0
)</errorConditionFormula>
    <errorMessage>You cannot set the event to &apos;On Sale&apos; until at least one Ticket Tier is created with capacity greater than 0.</errorMessage>
</ValidationRule>
