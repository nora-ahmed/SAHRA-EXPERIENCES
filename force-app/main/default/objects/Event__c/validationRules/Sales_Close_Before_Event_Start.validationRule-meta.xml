<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sales_Close_Before_Event_Start</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;On Sale&quot;),
    Sales_Close_Date__c &gt;=  Event_Start_Date__c 
)</errorConditionFormula>
    <errorMessage>Sales Close Date must be before the Event Start Date when the event is On Sale.</errorMessage>
</ValidationRule>
