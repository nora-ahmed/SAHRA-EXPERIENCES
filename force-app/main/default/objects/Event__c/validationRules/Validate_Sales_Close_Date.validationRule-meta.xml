<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Sales_Close_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;On Sale&quot;),
    Sales_Close_Date__c &lt; TODAY()
)</errorConditionFormula>
    <errorMessage>Sales Close Date must be in the future before moving to On Sale.</errorMessage>
</ValidationRule>
