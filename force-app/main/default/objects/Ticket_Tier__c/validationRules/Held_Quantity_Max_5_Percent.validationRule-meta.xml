<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Held_Quantity_Max_5_Percent</fullName>
    <active>true</active>
    <errorConditionFormula>Held_Quantity__c &gt; (Quantity_Available__c * 0.05)</errorConditionFormula>
    <errorMessage>Held Quantity cannot exceed 5% of Quantity Available.</errorMessage>
</ValidationRule>
