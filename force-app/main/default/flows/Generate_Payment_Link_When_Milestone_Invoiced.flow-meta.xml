<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Mock_Gateway_Response</name>
        <label>Mock Gateway Response</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varPaymentUrl</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>https://mock-pay.io/pay/TESTLINK123</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varTransactionId</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>TXN-MOCK-001</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Store_Payment_Link_on_Milestone</targetReference>
        </connector>
    </assignments>
    <environments>Default</environments>
    <formulas>
        <name>varPaymentLinkBody</name>
        <dataType>String</dataType>
        <expression>&apos;{&quot;milestone_id&quot;:&quot;&apos; &amp; {!$Record.Id} &amp; &apos;&quot;,&quot;amount&quot;:&apos; &amp; TEXT({!$Record.Amount__c}) &amp; &apos;,&quot;description&quot;:&quot;Payment for milestone: &apos; &amp; {!$Record.Name} &amp; &apos;&quot;}&apos;</expression>
    </formulas>
    <interviewLabel>Generate Payment Link When Milestone = &apos;Invoiced&apos; {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Generate Payment Link When Milestone = &apos;Invoiced&apos;</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Store_Payment_Link_on_Milestone</name>
        <label>Store Payment Link on Milestone</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Gateway_Transaction_ID__c</field>
            <value>
                <elementReference>varTransactionId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Payment_Link_Generated_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Payment_Link__c</field>
            <value>
                <elementReference>varPaymentUrl</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Invoiced</stringValue>
            </value>
        </filters>
        <object>Payment_Milestone__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <connector>
                <targetReference>Mock_Gateway_Response</targetReference>
            </connector>
            <pathType>AsyncAfterCommit</pathType>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
