    <decisions>
        <name>Is_Tickets_Sold</name>
        <label>Is Tickets Sold?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Tickets_Sold__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Quantity_Available__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Status</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Ticket_Tier_Auto_Sold_Out {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Ticket_Tier_Auto_Sold_Out</label>
    <processMetadataValues>
